# ── Database ────────────────────────────────────────────────────────────────
# Hostinger remote MySQL connection string used by Prisma.
# 1. hPanel → Databases → Management: create the MySQL database + user
# 2. hPanel → Databases → Remote MySQL: add your server IP (or enable "Any Host" / "%")
# 3. URL-encode special characters in the password ("+" → "%2B", "@" → "%40", ...)
DATABASE_URL="mysql://USERNAME:PASSWORD@MYSQL_HOSTNAME:3306/DATABASE_NAME"
